# Eigenständiger Betrieb ohne Home Assistant (Docker / Compose). Das Add-on nutzt "Dockerfile".
FROM alpine:3.22

RUN apk add --no-cache python3 py3-aiohttp tzdata \
    && adduser -D -H -u 1000 telex \
    && mkdir -p /data && chown telex /data

COPY app /app

ENV ITELEX_DATA=/data \
    ITELEX_STANDALONE=1 \
    ITELEX_WEB_PORT=8099 \
    TZ=Europe/Berlin

USER telex
WORKDIR /app
VOLUME /data
EXPOSE 11811 49491 8099

HEALTHCHECK --interval=60s --timeout=5s --start-period=20s \
    CMD wget -q -O /dev/null "http://127.0.0.1:${ITELEX_WEB_PORT}/login" || exit 1

CMD ["python3", "-u", "main.py"]

LABEL \
    org.opencontainers.image.title="i-Telex-Vermittlung" \
    org.opencontainers.image.description="i-Telex-Teilnehmerserver mit Vermittlung, Telefonbuch und Rufumleitung" \
    org.opencontainers.image.source="https://github.com/spliter90/ha-itelex" \
    org.opencontainers.image.licenses="MIT"
